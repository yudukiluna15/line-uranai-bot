# LINE Developers > チャネル設定 から取得
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# Anthropic Console から取得
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

# Stripe ダッシュボード から取得(スタンダード/プレミアムそれぞれの商品を作成)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_STANDARD=
STRIPE_PRICE_ID_PREMIUM=
STRIPE_SUCCESS_URL=https://example.com/success
STRIPE_CANCEL_URL=https://example.com/cancel

# DB(ローカル確認はSQLiteのままでOK。本番はPostgreSQL等に変更)
DATABASE_URL=sqlite:///./uranai.db

# 会話ログがこの件数を超えたら要約を作り直す
SUMMARY_THRESHOLD=6

# 無料ユーザーが1日に使える鑑定回数
FREE_DAILY_LIMIT=1

# キャラクターの表示名・アイコン画像URL(空欄のままだと公式アカウント名で送信される)
LUNA_NAME=ルナ
LUNA_ICON_URL=
GEN_NAME=玄
GEN_ICON_URL=

# 有料会員への毎日自動配信(日本時間)
DAILY_PUSH_ENABLED=true
DAILY_PUSH_HOUR=8
DAILY_PUSH_MINUTE=0

# タロットカード画像を用意したら、ここにベースURLを設定する(未設定なら画像なし)
TAROT_IMAGE_BASE_URL=
